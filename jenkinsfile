// test webhook - 20/10/2026

pipeline {
    agent any

    tools {
        maven 'mymaven'
    }

    stages {
        stage('Compile, test and package') {
            steps {
                sh 'mvn -B clean install'
            }
            post {
                always {
                    junit allowEmptyResults: true,
                          testResults: '**/target/surefire-reports/*.xml'
                    archiveArtifacts artifacts: 'target/site/jacoco/**',
                                     allowEmptyArchive: true
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                withSonarQubeEnv(
                    installationName: 'MySonarQubeServer',
                    credentialsId: 'sonarqubePWD'
                ) {
                    sh "mvn -B org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -Dsonar.projectKey=country-service -Dsonar.projectName=country-service"
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                sh 'mvn -B deploy -DskipTests'
            }
        }
    }
}